# Copy to .env (gitignored) or run `make secrets` (Phase 3) to generate real values.
# Placeholders only. Never put real secrets in this file.

# --- Lab (Phase 1) ---
# Docker network used for the lab management interfaces: "clab" or "k3d-netguard" (Phase 4)
LAB_MGMT_NETWORK=clab

# --- Kafka (Phase 1) ---
KAFKA_BOOTSTRAP=localhost:9092

# --- PostgreSQL (Phase 2) ---
POSTGRES_DB=netguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
TELEMETRY_DB_PASSWORD=changeme
CONFIG_DB_PASSWORD=changeme

# --- Keycloak (Phase 3) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=generated-by-make-secrets
NETGUARD_VIEWER_PASSWORD=generated-by-make-secrets
NETGUARD_OPERATOR_PASSWORD=generated-by-make-secrets
NETGUARD_ADMIN_PASSWORD=generated-by-make-secrets
